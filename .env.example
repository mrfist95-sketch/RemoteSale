# ============================================================
# OnSale — конфигурация окружения
# Скопируйте этот файл в .env и заполните значения.
#   cp .env.example .env
# Файл .env НЕ коммитится в git и НЕ попадает в дистрибутив.
# ============================================================

# --- База данных (SQLite) ---
# В Docker файл лежит в volume /app/data — путь менять не нужно.
# Для запуска без Docker (локально) можно оставить как есть:
DATABASE_URL="file:./dev.db"

# --- Публичный адрес приложения ---
# Адрес, по которому приложение доступно пользователям (для редиректов NextAuth).
# Примеры: http://10.0.10.200:3000  или  https://onsale.galero.tech
NEXTAUTH_URL="http://localhost:3000"

# --- Секрет NextAuth (подпись и шифрование сессий) ---
# ОБЯЗАТЕЛЬНО замените на свой случайный ключ (32 байта hex).
# Сгенерировать:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="ЗАМЕНИТЕ-НА-СЛУЧАЙНЫЙ-КЛЮЧ"
AUTH_SECRET="ЗАМЕНИТЕ-НА-СЛУЧАЙНЫЙ-КЛЮЧ"

# --- Администратор, создаваемый при первом запуске (seed) ---
# В чистой базе эти учётные данные — единственный способ войти.
# Минимальная длина пароля — 8 символов; без них контейнер не запустится.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ЗАМЕНИТЕ-НА-СВОЙ-ПАРОЛЬ"

# --- Watchdog (контроль живости, опционально) ---
# WATCHDOG_INTERVAL=15000      # период проверки здоровья, мс
# WATCHDOG_MAX_FAILS=3         # неудач подряд до перезапуска приложения